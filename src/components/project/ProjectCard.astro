---
// Adapted from Firefly's ProjectCard component (MIT License).
import path from "node:path";
import { Icon } from "astro-icon/components";
import { formatDateToYYYYMMDD } from "@utils/date-utils";
import { getProjectUrlBySlug, getDir } from "@utils/url-utils";
import { getProjectStatusMeta, resolveLinkIcon } from "@utils/projects-utils";
import ImageWrapper from "@components/misc/ImageWrapper.astro";

interface Props {
	slug: string;
	id: string;
	title: string;
	description: string;
	image: string;
	tags: string[];
	published: Date;
	status: string;
	link: { label: string; icon: string; value: string }[];
}

const { slug, id, title, description, image, tags, published, status, link } = Astro.props;
const statusMeta = getProjectStatusMeta(status);
const projectUrl = getProjectUrlBySlug(slug);
const visibleTags = tags.slice(0, 2);
const hiddenTagCount = tags.length - visibleTags.length;
---

<article class="project-card card-base flex w-full flex-col overflow-hidden rounded-[var(--radius-large)]" data-status={status} data-tags={tags.join(",")}>
	<a href={projectUrl} aria-label={title} class="group relative block aspect-[2/1] overflow-hidden bg-black/5 dark:bg-white/10">
		{image ? (
			<ImageWrapper src={image} basePath={path.join("content/projects/", getDir(id))} alt={title} class="h-full w-full transition duration-300 group-hover:scale-105" />
		) : (
			<div class="flex h-full items-center justify-center text-[var(--primary)]"><Icon name="material-symbols:rocket-launch-outline-rounded" class="text-6xl opacity-70" /></div>
		)}
		<div class="pointer-events-none absolute inset-0 bg-black/0 transition group-hover:bg-black/30"></div>
		<Icon name="material-symbols:arrow-outward-rounded" class="pointer-events-none absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 scale-75 text-5xl text-white opacity-0 transition group-hover:scale-100 group-hover:opacity-100" />
		{statusMeta && <span class:list={["absolute right-3 top-3 inline-flex items-center gap-1 rounded-full px-2.5 py-1 text-xs font-medium backdrop-blur", statusMeta.coverClassName]}>{statusMeta.icon && <Icon name={statusMeta.icon} class="text-sm" />}{statusMeta.label}</span>}
	</a>
	<div class="flex min-h-0 flex-1 flex-col p-5">
		<a href={projectUrl} class="line-clamp-1 text-xl font-bold text-90 transition hover:text-[var(--primary)]">{title}</a>
		<div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-50"><time datetime={published.toISOString()}>{formatDateToYYYYMMDD(published)}</time>{visibleTags.length > 0 && <span>{visibleTags.join(" / ")}{hiddenTagCount > 0 && ` +${hiddenTagCount}`}</span>}</div>
		{description && <p class="mt-3 line-clamp-2 text-sm leading-relaxed text-75">{description}</p>}
		<div class="mt-5 flex flex-wrap items-center gap-2">
			{link.map((item) => { const icon = resolveLinkIcon(item.icon, item.label); return <a href={item.value} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 rounded-lg bg-[var(--btn-plain-bg-hover)] px-2.5 py-1.5 text-xs font-medium text-[var(--primary)] transition hover:bg-[var(--btn-plain-bg-active)]">{icon.kind === "icon" && <Icon name={icon.value} class="text-sm" />}{icon.kind === "image" && <img src={icon.value} alt="" class="h-3.5 w-3.5 object-contain" loading="lazy" />}{icon.kind === "letter" && <span class="font-bold">{icon.value}</span>}{item.label}</a>; })}
			<a href={projectUrl} class="ml-auto inline-flex items-center gap-1 text-xs font-medium text-50 transition hover:text-[var(--primary)]">查看详情 <Icon name="material-symbols:chevron-right-rounded" class="text-base" /></a>
		</div>
	</div>
</article>

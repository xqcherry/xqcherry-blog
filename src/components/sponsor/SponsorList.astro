---
import type { SponsorEntry as SponsorEntryType } from "@/types/config";

interface Props {
	entries: SponsorEntryType[];
}
const { entries } = Astro.props;
---

<section aria-labelledby="sponsor-list-title" class="mt-9">
	<h2 id="sponsor-list-title" class="text-lg font-bold text-75">赞助名单</h2>
	{entries.length === 0 ? (
		<p class="mt-3 rounded-xl border border-dashed border-[var(--line-divider)] px-4 py-5 text-sm text-50">暂时还没有公开的赞助记录。</p>
	) : (
		<ul class="mt-3 overflow-hidden rounded-xl border border-[var(--line-divider)] divide-y divide-[var(--line-divider)]">
			{entries.map((entry) => (
				<li class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 px-4 py-3">
					<div class="min-w-0"><span class="font-medium text-75">{entry.name}</span>{entry.message && <p class="mt-1 text-sm text-50">{entry.message}</p>}</div>
					<div class="flex shrink-0 gap-2 text-sm text-50">{entry.amount && <span class="text-[var(--primary)]">{entry.amount}</span>}{entry.date && <time>{entry.date}</time>}</div>
				</li>
			))}
		</ul>
	)}
</section>

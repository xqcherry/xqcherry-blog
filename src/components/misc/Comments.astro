---
import "artalk/Artalk.css";
import { commentConfig } from "../../config";

const serverURL = commentConfig.serverURL.trim();
const siteName = commentConfig.siteName.trim();
---

<section class="artalk-container mt-2 border-t border-dashed border-[var(--line-divider)] pt-6 onload-animation" aria-label="评论区">
    <div id="artalk-comments" data-server-url={serverURL} data-site-name={siteName}></div>
</section>

<script>
function createController() {
    const controller: NonNullable<Window["artalkComments"]> = {
        instance: null,
        observer: null,
        themeObserver: null,
        target: null,
        hooksRegistered: false,
        syncTheme() {
            controller.instance?.setDarkMode(document.documentElement.classList.contains("dark"));
        },
        destroy() {
            controller.observer?.disconnect();
            controller.instance?.destroy();
            controller.observer = null;
            controller.instance = null;
            controller.target = null;
        },
        init() {
            if (!controller.themeObserver) {
                controller.themeObserver = new MutationObserver(controller.syncTheme);
                controller.themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ["class"] });
            }

            const container = document.getElementById("artalk-comments");

            if (!container) {
                controller.destroy();
                return;
            }

            if (controller.target === container) return;

            controller.destroy();
            const serverURL = container.dataset.serverUrl?.trim();
            const siteName = container.dataset.siteName?.trim();
            if (!serverURL || !siteName) return;
            controller.target = container;

            const mount = async () => {
                const { default: Artalk } = await import("artalk");
                if (controller.target !== container || !container.isConnected) return;

                controller.instance = Artalk.init({
                    el: container,
                    server: serverURL,
                    site: siteName,
                    pageKey: window.location.pathname,
                    pageTitle: document.title,
                    darkMode: document.documentElement.classList.contains("dark"),
                    locale: "zh-CN",
                });
            };

            if (!("IntersectionObserver" in window)) {
                void mount();
                return;
            }

            controller.observer = new IntersectionObserver((entries) => {
                if (!entries.some((entry) => entry.isIntersecting)) return;

                controller.observer?.disconnect();
                controller.observer = null;
                void mount();
            }, { rootMargin: "400px 0px" });
            controller.observer.observe(container);
        },
    };

    return controller;
}

const controller = window.artalkComments ?? createController();
window.artalkComments = controller;
controller.init();

const registerHooks = () => {
    if (controller.hooksRegistered) return;

    window.swup.hooks.on("content:replace", controller.destroy, { before: true });
    window.swup.hooks.on("page:view", controller.init);
    controller.hooksRegistered = true;
};

if (window.swup?.hooks) {
    registerHooks();
} else {
    document.addEventListener("swup:enable", registerHooks, { once: true });
}
</script>

<style>
.artalk-container :global(.atk-main) {
    margin: 0;
}
</style>

---
import { Icon } from "astro-icon/components";
import { siteConfig } from "@/config";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import { getSiteStats } from "@utils/content-utils";
import WidgetLayout from "./WidgetLayout.astro";

const stats = await getSiteStats(siteConfig.startedAt);
const formatter = new Intl.NumberFormat(siteConfig.lang.replace("_", "-"));
const items = [
	{ icon: "material-symbols:article-outline-rounded", label: i18n(I18nKey.statPosts), value: stats.posts },
	{ icon: "material-symbols:folder-outline-rounded", label: i18n(I18nKey.statCategories), value: stats.categories },
	{ icon: "material-symbols:tag-rounded", label: i18n(I18nKey.statTags), value: stats.tags },
	{ icon: "material-symbols:notes-rounded", label: i18n(I18nKey.statWords), value: stats.words },
	{ icon: "material-symbols:calendar-month-outline-rounded", label: i18n(I18nKey.statRunningDays), value: stats.runningDays },
];

interface Props {
	class?: string;
	style?: string;
}
const className = Astro.props.class;
const style = Astro.props.style;
---

<WidgetLayout name={i18n(I18nKey.siteStats)} id="site-stats" class={className} style={style}>
	<dl class="px-4 divide-y divide-[var(--line-divider)]">
		{items.map((item) => (
			<div class="flex items-center justify-between gap-3 py-2.5">
				<dt class="flex items-center gap-2 text-sm text-50">
					<Icon name={item.icon} class="text-[1em] text-[var(--primary)]" />
					{item.label}
				</dt>
				<dd class="text-sm font-bold text-75 tabular-nums">{formatter.format(item.value)}</dd>
			</div>
		))}
	</dl>
</WidgetLayout>

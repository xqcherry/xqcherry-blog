---
import StaticPageCard from "@components/misc/StaticPageCard.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
---

<MainGridLayout title="留言板" description="留下想说的话">
	<StaticPageCard title="留言板" description="欢迎留下想说的话。">
		<div class="rounded-xl border border-dashed border-[var(--line-divider)] bg-black/[0.015] px-5 py-6 dark:bg-white/[0.025]">
			<p class="font-medium text-75">互动功能正在准备中</p>
			<p class="mt-2 text-sm leading-6 text-50">评论服务上线后，这里会开放为独立留言区，不会和文章评论混在一起。</p>
		</div>
	</StaticPageCard>
</MainGridLayout>
